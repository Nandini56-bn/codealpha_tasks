# Environment Variables Configuration
# Copy this file to .env and fill in your keys
# Never commit .env — GEMINI_API_KEY must stay on the server.

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Google Gemini API Key (server-side only)
# Used for:
#   1) Gemini music director / mixed-language chatbot / original lyrics
#   2) Lyria 3.5 AI song generation (same key, different model)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides (official IDs)
GEMINI_DIRECTOR_MODEL=gemini-2.5-flash
LYRIA_MODEL=lyria-3.5
